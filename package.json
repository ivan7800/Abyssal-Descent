{
  "name": "abyssal-descent",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve-static.cjs docs 5173",
    "build": "node scripts/build-static.cjs",
    "preview": "node scripts/serve-static.cjs dist 4173",
    "typecheck": "tsc -b --pretty false",
    "validate": "node scripts/validate.cjs",
    "check": "npm run test && npm run static-check && npm run runtime-smoke && npm run v13-runtime && npm run v14-runtime && npm run build",
    "balance": "node scripts/balance.cjs",
    "ui-regression": "node scripts/ui-regression.cjs",
    "test": "npm run validate && npm run balance && npm run ui-regression && npm run i18n-check && npm run v13-check && npm run v14-check",
    "build:source": "tsc -b && vite build",
    "static-check": "node scripts/static-check.cjs",
    "runtime-smoke": "node scripts/standalone-runtime.cjs",
    "dev:source": "vite --open /source.html",
    "i18n-check": "node scripts/i18n-check.cjs",
    "v13-check": "node scripts/v13-check.cjs",
    "v13-runtime": "node scripts/v13-runtime.cjs",
    "v14-check": "node scripts/v14-check.cjs",
    "v14-runtime": "node scripts/v14-runtime.cjs"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
